<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.tablasbennu.mapper.ResultMaps">

    <!-- column: nombre en PostgreSQL. property: propiedad existente en el modelo Java. -->
    <resultMap id="sucursalMap" type="cl.bennu.tablasbennu.model.Sucursal">
        <id column="id_sucursal" property="idSucursal"/>
        <result column="id_pais" property="idPais"/>
        <result column="nombre" property="nombre"/>
        <result column="hora" property="hora"/>
    </resultMap>

    <resultMap id="trabajadorMap" type="cl.bennu.tablasbennu.model.Trabajador">
        <id column="id_trabajador" property="idTrabajador"/>
        <result column="id_sucursal" property="idSucursal"/>
        <result column="dni" property="dni"/>
        <result column="nombres" property="nombres"/>
        <result column="apellidos" property="apellidos"/>
        <result column="puesto" property="puesto"/>
    </resultMap>

</mapper>
